# Copy to .env.local and fill in from https://dashboard.clerk.com → API keys.
# Publishable key is safe for the browser; the secret key must stay server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Postgres (https://console.neon.tech → your project → Connect).
# Use the pooled connection string; server-only, never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
